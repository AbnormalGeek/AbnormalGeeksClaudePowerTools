{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(gh repo create:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(bash __HOME__/.claude/context/resolve-slices.sh:*)",
      "Read(//__HOME__/.claude/planning/**)",
      "Edit(//__HOME__/.claude/planning/**)",
      "Read(//__HOME__/.claude/context/**)",
      "Edit(//__HOME__/.claude/context/**)",
      "Read(//__HOME__/.claude/templates/**)",
      "Edit(//__HOME__/.claude/templates/**)",
      "Edit(//__HOME__/.claude/agents/**)",
      "Edit(//__HOME__/.claude/skills/**)",
      "Edit(//__HOME__/.claude/state/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' \"$(jq -r '.message // \"needs your attention\"')\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-liveliness.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-liveliness.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 1000
  },
  "autoMemoryEnabled": true
}
